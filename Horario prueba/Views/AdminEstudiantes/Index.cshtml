@model IEnumerable<Horario_prueba.Models.Estudiante>

@{
    ViewData["Title"] = "Estudiantes";
    var adminEmails = ViewBag.AdminEmails as HashSet<string> ?? new HashSet<string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Estudiantes registrados</h2>
        <a class="btn btn-primary" href="/AdminEstudiantes/Crear">
            <i class="fas fa-plus"></i> Nuevo
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay estudiantes registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Email</th>
                        <th>Admin</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var esAdmin = adminEmails.Contains((e.Email ?? "").ToLower());

                        <tr>
                            <td>@e.Nombre</td>
                            <td>@e.Codigo</td>
                            <td>@e.Email</td>
                            <td>@(esAdmin ? "Sí" : "No")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary me-2" href="/AdminEstudiantes/Editar/@e.IdEstudiante">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a class="btn btn-sm btn-outline-danger" href="/AdminEstudiantes/Eliminar/@e.IdEstudiante">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
}
