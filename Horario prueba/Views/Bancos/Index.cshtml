@model IEnumerable<Horario_prueba.Models.Banco>

@{
    ViewData["Title"] = "Bancos";
}

<div class="lab-page-wrapper">
    <div class="lab-container">
        <div class="lab-header">
            <div>
                <h1>Bancos</h1>
                <p class="lab-subtitle">
                    Administra los bancos de cada laboratorio.
                </p>
            </div>
            <a href="@Url.Action("Crear", "Bancos")" class="btn btn-danger lab-btn-new">
                <i class="fas fa-plus-circle me-2"></i> Nuevo banco
            </a>
        </div>

        <div class="lab-card">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-microscope fa-2x mb-3"></i>
                    <p>No hay bancos registrados aún.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table lab-table align-middle">
                        <thead>
                            <tr>
                                <th>Laboratorio</th>
                                <th>Código</th>
                                <th>Capacidad</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>@b.Laboratorio?.Nombre</td>
                                    <td>@b.Codigo</td>
                                    <td>@b.Capacidad</td>
                                    <td>@b.Estado</td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Editar", "Bancos", new { id = b.IdBanco })"
                                           class="btn btn-sm btn-outline-secondary me-2">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                        <a href="@Url.Action("Eliminar", "Bancos", new { id = b.IdBanco })"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash-alt"></i> Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
}

<style>
    /* Reusamos los estilos del Index de Laboratorios */
    :root {
        --primary-red: #d62839;
        --dark-red: #a51c30;
        --light-gray: #f5f5f5;
        --white: #ffffff;
    }

    .lab-page-wrapper {
        background-image: linear-gradient(135deg, rgba(214,40,57,0.08) 0%, rgba(255,255,255,0.9) 50%);
        padding: 30px 0;
    }

    .lab-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .lab-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .lab-header h1 {
            font-weight: 700;
            color: #333;
            margin-bottom: 5px;
        }

    .lab-subtitle {
        margin: 0;
        color: #777;
        font-size: 0.95rem;
    }

    .lab-card {
        background: var(--white);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(214, 40, 57, 0.15);
        padding: 20px 25px;
    }

    .lab-table thead {
        background-color: var(--primary-red);
        color: white;
    }

        .lab-table thead th {
            border: none;
        }

    .lab-table tbody tr:nth-child(even) {
        background-color: rgba(214, 40, 57, 0.03);
    }

    .lab-btn-new {
        background-color: var(--primary-red);
        border-color: var(--primary-red);
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 18px;
    }

        .lab-btn-new:hover {
            background-color: var(--dark-red);
            border-color: var(--dark-red);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(214, 40, 57, 0.3);
        }
</style>
