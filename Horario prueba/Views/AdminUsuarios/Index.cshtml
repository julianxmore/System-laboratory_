@model IEnumerable<Horario_prueba.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios / Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Usuarios / Administradores</h2>
        <a class="btn btn-primary" href="/AdminUsuarios/Crear">
            <i class="fas fa-plus"></i> Nuevo
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay usuarios registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Código</th>
                        <th>Email</th>
                        <th>Admin</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Nombre</td>
                            <td>@u.Codigo</td>
                            <td>@u.Email</td>
                            <td>
                                @(u.EsAdmin ? "Sí" : "No")
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary me-2" href="/AdminUsuarios/Editar/@u.Id">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a class="btn btn-sm btn-outline-danger" href="/AdminUsuarios/Eliminar/@u.Id">
                                    <i class="fas fa-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
}
