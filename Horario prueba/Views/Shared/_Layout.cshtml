@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Labs UD</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts - Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap (tu versión local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --primary-red: #d62839;
            --dark-red: #a51c30;
            --light-red: #f8e8e8;
            --accent-gold: #f4a261;
            --dark-gray: #333333;
            --light-gray: #f5f5f5;
            --white: #ffffff;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--light-gray);
            padding: 20px;
            background-image: linear-gradient(135deg, rgba(214,40,57,0.08) 0%, rgba(255,255,255,0.9) 50%);
        }

        .main-container {
            max-width: 1400px;
            background-color: var(--white);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(214, 40, 57, 0.15);
            padding: 30px;
            margin: 20px auto 40px auto;
        }

        h1 {
            font-weight: 700;
            color: var(--dark-gray);
            margin-bottom: 30px;
            text-align: center;
            position: relative;
            padding-bottom: 15px;
        }

            h1::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 4px;
                background: var(--primary-red);
                border-radius: 2px;
            }

        h2 {
            font-weight: 600;
            color: var(--primary-red);
            margin-bottom: 20px;
            font-size: 1.5rem;
        }

        .section {
            margin-bottom: 40px;
            padding: 25px;
            background-color: var(--white);
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border: 1px solid rgba(214, 40, 57, 0.1);
            transition: all 0.3s ease;
        }

            .section:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(214, 40, 57, 0.1);
            }

        .btn-primary {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
        }

            .btn-primary:hover {
                background-color: var(--dark-red);
                border-color: var(--dark-red);
                transform: translateY(-2px);
            }

        .btn-danger {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-danger:hover {
                background-color: var(--dark-red);
                border-color: var(--dark-red);
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(214, 40, 57, 0.3);
            }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 10px 15px;
            border: 1px solid #ddd;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-red);
                box-shadow: 0 0 0 0.25rem rgba(214, 40, 57, 0.25);
            }

        .footer {
            text-align: center;
            margin-top: 40px;
            color: #777;
            font-size: 0.9rem;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }
    </style>

    @RenderSection("Styles", required: false)

</head>
<body>
    @{
        var nombre = HttpContextAccessor.HttpContext?.Session.GetString("Nombre");
        var esAdmin = HttpContextAccessor.HttpContext?.Session.GetString("EsAdmin") == "true";
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light px-3 rounded-3 shadow-sm">
            <a class="navbar-brand fw-bold text-danger" asp-controller="Account" asp-action="Login">
                Labs UD
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNav" aria-controls="mainNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @* --- Opciones solo para administrador --- *@
                    @if (esAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Laboratorios" asp-action="Index">Laboratorios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Bancos" asp-action="Index">Bancos</a>
                        </li>
                    }

                    @* --- Disponible para todos los usuarios --- *@
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reservas" asp-action="MisReservas">Mis Reservas</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    @if (!string.IsNullOrEmpty(nombre))
                    {
                        <li class="nav-item">
                            <span class="navbar-text me-3">
                                Hola, @nombre
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                                Salir
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Ingresar</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <div class="footer">
            &copy; @DateTime.Now.Year - Labs UD
        </div>
    </div>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
