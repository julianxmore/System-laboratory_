@model IEnumerable<Horario_prueba.Models.Laboratorio>
@{
    ViewData["Title"] = "Laboratorios";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f5f5f5;
        }

        .page-title {
            font-weight: 700;
            color: #333333;
            position: relative;
            padding-bottom: 10px;
        }

            .page-title::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 0;
                width: 120px;
                height: 4px;
                background: #d62839;
                border-radius: 2px;
            }

        .card-labs {
            border-radius: 16px;
            border: 1px solid rgba(214,40,57,0.12);
            box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        }

        .table thead {
            background-color: #d62839;
            color: white;
        }

        .table tbody tr:nth-child(even) {
            background-color: rgba(214,40,57,0.03);
        }

        .badge-sede {
            background-color: #f8e8e8;
            color: #a51c30;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 0.8rem;
        }
    </style>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Gestión de Laboratorios</h1>
            <p class="text-muted mb-0">
                Consulta y administra los laboratorios disponibles para reservas.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-danger">
                <i class="fas fa-plus"></i> Nuevo laboratorio
            </a>
        </div>
    </div>

    <div class="card card-labs">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Sede</th>
                            <th>Piso</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lab in Model)
                        {
                            <tr>
                                <td>@lab.Nombre</td>
                                <td><span class="badge badge-sede">@lab.Sede</span></td>
                                <td>@lab.Piso</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@lab.IdLaboratorio" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@lab.IdLaboratorio" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
