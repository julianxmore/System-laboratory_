@model Horario_prueba.Models.Laboratorio

@{
    ViewData["Title"] = "Eliminar laboratorio";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Confirmar eliminación
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-4">
                        ¿Seguro que deseas eliminar el laboratorio
                        <strong>@Model.Nombre</strong>?
                    </p>

                    <dl class="row">
                        <dt class="col-sm-3">Sede</dt>
                        <dd class="col-sm-9">@Model.Sede</dd>

                        <dt class="col-sm-3">Piso</dt>
                        <dd class="col-sm-9">@Model.Piso</dd>

                        <dt class="col-sm-3">Observaciones</dt>
                        <dd class="col-sm-9">@Model.Observaciones</dd>
                    </dl>

                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" asp-for="IdLaboratorio" />
                        <button type="submit" class="btn btn-danger me-2">
                            <i class="fas fa-trash-alt"></i> Eliminar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
